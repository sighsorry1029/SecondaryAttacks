<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SourceRoot Condition="'$(SourceRoot)' == ''">$(MSBuildThisFileDirectory)../..</SourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Stubs.cs" />
    <Compile Include="$(SourceRoot)/SecondaryAttackDefinitionCompiler.cs" Link="Production/SecondaryAttackDefinitionCompiler.cs" />
    <Compile Include="$(SourceRoot)/SecondaryAttackRuntimeWeaponRebind.cs" Link="Production/SecondaryAttackRuntimeWeaponRebind.cs" />
  </ItemGroup>
</Project>
