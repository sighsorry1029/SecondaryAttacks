<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <DefineConstants Condition="'$(PoVMagazine)' == 'true'">$(DefineConstants);POV_MAGAZINE</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BepInExCore Condition="'$(BepInExCore)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Valheim/BepInEx/core</BepInExCore>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Compat/EpicLootCompat.cs" Link="Production/EpicLootCompat.cs" />
    <Compile Include="obj/ProductionSlices.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="PathOfValheiman.cs" />
    <Compile Include="../../Compat/PathOfValheimanCompat.cs" Link="Production/PathOfValheimanCompat.cs" />
    <Compile Include="Stubs.cs" />
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)/0Harmony.dll</HintPath></Reference>
    <None Include="$(BepInExCore)/MonoMod*.dll;$(BepInExCore)/Mono.Cecil*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
